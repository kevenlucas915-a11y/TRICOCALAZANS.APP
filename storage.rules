rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Verificação de administrador harmonizada com firestore.rules
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['kevenlucas915@gmail.com'];
    }

    // Acervo visual oficial do Atlas de Tricoscopia (17 condições clínicas)
    match /atlas/{casoId}/{arquivo} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
                            && request.resource.contentType.matches('image/.*')
                            && request.resource.size < 15 * 1024 * 1024;
    }

    // Sessões de fototricoscopia da bancada, exames laboratoriais, fotos clínicas e laudos
    match /capturas/{uid}/{allPaths=**} {
      allow read: if true;
      allow delete: if request.auth == null || request.auth.uid == uid || isAdmin();
      allow create, update: if (request.auth == null || request.auth.uid == uid || isAdmin())
                            && (
                              request.resource.contentType.matches('image/.*')
                              || request.resource.contentType == 'application/pdf'
                              || request.resource.contentType == 'application/octet-stream'
                            )
                            && request.resource.size <= 25 * 1024 * 1024;
    }

    // Bloqueio padrão para qualquer outra pasta não mapeada
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

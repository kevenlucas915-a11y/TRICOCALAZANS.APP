# PORT & AMBIENTE
PORT=3000
NODE_ENV="production"

# APP_URL: Domínio público oficial onde o app está hospedado.
# Necessário para os redirecionamentos de retorno do Stripe (success_url / cancel_url).
APP_URL="https://seu-dominio.com"

# GEMINI_API_KEY: Chave da API do Google Gemini para transcrição inteligente de laudos e exames laboratoriais.
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSy..."

# STRIPE: Configuração de pagamentos e assinaturas (Plano Mensal e Anual com Pix e Cartão)
# Obtenha em: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_live_sua_chave_secreta_stripe"
VITE_STRIPE_PUBLISHABLE_KEY="pk_live_sua_chave_publica_stripe"
# Segredo do Webhook (cadastre no painel Stripe apontando para https://SEU_DOMINIO/api/stripe/webhook)
STRIPE_WEBHOOK_SECRET="whsec_seu_segredo_webhook_stripe"

# FIREBASE_SERVICE_ACCOUNT: (Opcional) Credenciais de serviço JSON para validação administrativa no servidor
# Obtenha em: Firebase Console -> Configurações do Projeto -> Contas de Serviço -> Gerar nova chave privada
FIREBASE_SERVICE_ACCOUNT="{\"type\":\"service_account\",\"project_id\":\"secret-watch-txfhk\"}"

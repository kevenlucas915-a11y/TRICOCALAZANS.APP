  "firestore": {
    "/caso_imagens/{casoId}": {
      "schema": "CasoImagem",
      "description": "Armazena as imagens clínicas sincronizadas de cada caso do Atlas."
    },
    "/capturas_paciente/{capturaId}": {
      "schema": "CapturaPaciente",
      "description": "Armazena capturas tricoscópicas de pacientes realizadas pelo profissional."
    },
    "/pacientes/{pacienteId}": {
      "schema": "Paciente",
      "description": "Armazena as fichas cadastrais e prontuários tricológicos de pacientes."
    },
    "/convites_pacientes/{token}": {
      "schema": "ConvitePaciente",
      "description": "Armazena tokens únicos de ativação de convite para a área do cliente."
    },
    "/pacientes_usuarios/{uid}": {
      "schema": "PacienteUsuario",
      "description": "Armazena perfis e papéis de usuários com acesso de paciente."

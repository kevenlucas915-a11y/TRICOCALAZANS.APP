      "type": "object",
      "properties": {
        "casoId": {
          "type": "string",
          "description": "Identificador do caso clínico",
          "maxLength": 128
        },
        "nomeArquivo": {
          "type": "string",
          "description": "Nome original do arquivo enviado",
          "maxLength": 255
        },
        "tamanhoBytes": {
          "type": "number",
          "description": "Tamanho do arquivo em bytes"
        },
        "dataUrl": {
          "type": "string",
          "description": "Dados da imagem em base64",
          "maxLength": 900000
        },
        "updatedAt": {
          "type": "string",
          "description": "Data e hora ISO da última atualização",
          "maxLength": 64
        }
      },
      "required": ["casoId", "nomeArquivo", "tamanhoBytes", "dataUrl"]
    },
